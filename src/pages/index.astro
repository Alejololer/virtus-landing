---
import Base from "../layouts/Base.astro";
import {
  services, SERVICES_INITIAL, team, clients,
  PHONE, PHONE_HUMAN, WA_GENERAL, WA_CONSULTA, WA_EMPRESA,
} from "../data/site.js";
import { ciudades, materias } from "../data/paginas.js";

const title = "Abogados en Cotopaxi — Virtus Estudio Jurídico | Salcedo";
const description =
  "Abogados en Cotopaxi con oficina en Salcedo, frente a la Judicatura. Derecho penal, laboral, civil, familia, cobranzas y marcas en Salcedo, Latacunga y Ambato. Urgencias 24/7.";

const faq = [
  {
    q: "¿Dónde están ubicados?",
    a: "En Salcedo, Cotopaxi: Bolívar y C. Belisario Quevedo, Edificio Vecamores, frente a la Judicatura de Salcedo. Atendemos casos en todo Cotopaxi y a nivel nacional.",
  },
  {
    q: "¿Cómo agendo una consulta?",
    a: "Por WhatsApp al +593 99 551 6608. Se revisa brevemente el asunto, se define si requiere reunión presencial y se agenda.",
  },
  {
    q: "¿Atienden urgencias fuera de horario?",
    a: "Sí. Detenciones, flagrancias y medidas urgentes se atienden 24/7 por WhatsApp. Las consultas ordinarias se atienden en horario de oficina.",
  },
  {
    q: "¿Qué áreas del Derecho cubren?",
    a: "Penal, laboral, civil y contratos, familia y sucesiones, administrativo, societario, propiedad intelectual, protección de datos y derecho digital, además de cobro de cartera.",
  },
  {
    q: "¿Trabajan con empresas?",
    a: "Sí. Damos acompañamiento continuo a negocios de Salcedo, Latacunga y Ambato en materia contractual, laboral, de cobranzas y de marcas.",
  },
];
---

<Base title={title} description={description} path="/" faq={faq}>
  <section id="top" class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow"><span class="eyebrow-line"></span>ABOGADOS EN SALCEDO · COTOPAXI</div>
        <h1>Asesoría estratégica, <em>prevención</em> y patrocinio legal en Cotopaxi.</h1>
        <p class="lead">Estudio jurídico multidisciplinario con oficina en Salcedo, frente a la Judicatura. Patrocinamos casos en Salcedo, Latacunga, Ambato y a nivel nacional, integrando distintas áreas del Derecho en una sola estrategia.</p>
        <div class="btn-row">
          <a href={WA_CONSULTA} target="_blank" rel="noopener" class="btn btn-gold">Agendar consulta</a>
          <a href="#servicios" class="btn btn-outline">Ver servicios</a>
        </div>
        <p class="hero-urgencias">Atención de urgencias 24/7 por WhatsApp · {PHONE_HUMAN}</p>
      </div>
      <div class="hero-img-wrap">
        <div class="hero-img-frame" aria-hidden="true"></div>
        <img src="/fotos/oficina-virtus-salcedo-ventanal-amanecer.webp" width="896" height="1195"
          alt="Oficina de Virtus Estudio Jurídico en Salcedo al amanecer, con el ventanal rotulado frente a la Judicatura"
          class="hero-img" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="wrap stats-grid">
      <div class="stat">
        <div class="stat-title">EXPERIENCIA</div>
        <p>Práctica acumulada en materia procesal, penal, laboral y civil.</p>
      </div>
      <div class="stat">
        <div class="stat-title">COMPROMISO</div>
        <p>Atención directa del abogado responsable en cada expediente.</p>
      </div>
      <div class="stat">
        <div class="stat-title">RESULTADOS</div>
        <p>Resolución y seguimiento de casos a nivel nacional en Ecuador.</p>
      </div>
    </div>
  </section>

  <section id="enfoque" class="enfoque">
    <div class="wrap enfoque-grid">
      <div>
        <span class="kicker">NUESTRO ENFOQUE</span>
        <div class="rule"></div>
        <img src="/fotos/recepcion-virtus-estudio-juridico-salcedo.webp" width="1000" height="667" alt="Recepción y sala de espera de Virtus Estudio Jurídico en Salcedo, Cotopaxi" class="enfoque-img" loading="lazy" decoding="async" />
      </div>
      <div>
        <p class="enfoque-statement">Integramos distintas áreas del Derecho para brindar soluciones jurídicas coordinadas, estratégicas y adaptadas a las necesidades de cada cliente.</p>
        <div class="enfoque-pillars">
          <div>
            <div class="pillar-title">ASESORÍA</div>
            <p>Criterio jurídico claro antes de decidir, contratar o litigar.</p>
          </div>
          <div>
            <div class="pillar-title">PREVENCIÓN</div>
            <p>Gestión de riesgos legales, contratos y cumplimiento normativo.</p>
          </div>
          <div>
            <div class="pillar-title">PATROCINIO</div>
            <p>Defensa técnica y representación en sede judicial y administrativa.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="servicios" class="servicios">
    <div class="wrap">
      <div class="servicios-head">
        <div>
          <span class="kicker">SERVICIOS JURÍDICOS</span>
          <h2>Áreas de práctica</h2>
        </div>
        <p class="servicios-desc">Cobertura completa en materia civil, penal, laboral, administrativa, corporativa y digital para clientes de Cotopaxi y todo el Ecuador.</p>
      </div>
      <div class="services-grid" id="services-grid" data-expanded="false">
        {services.map((s, i) => (
          <div class:list={["service-item", { "service-extra": i >= SERVICES_INITIAL }]}>
            <span class="service-num">{s.num}</span>
            <span>{s.name}</span>
          </div>
        ))}
      </div>
      <button id="services-toggle" class="services-toggle" type="button">
        Ver las {services.length} áreas
      </button>
    </div>
  </section>

  <section class="quote">
    <img src="/fotos/sala-de-trabajo-abogados-virtus-salcedo.webp" width="1195" height="896" alt="Sala de trabajo del equipo de Virtus Estudio Jurídico en Salcedo" class="quote-img" loading="lazy" decoding="async" />
    <div class="quote-overlay" aria-hidden="true"></div>
    <div class="wrap quote-content">
      <div class="rule rule-gold"></div>
      <p>Cada caso se atiende con estrategia, plazos claros y seguimiento directo del abogado responsable.</p>
    </div>
  </section>

  <section id="equipo" class="equipo">
    <div class="wrap">
      <div class="equipo-head">
        <span class="kicker kicker-gold">EL EQUIPO</span>
        <h2 class="h-light">Especialidades</h2>
      </div>
      <div class="team-grid">
        {team.map((m) => (
          <div class="team-card">
            <img class="team-portrait" src={m.foto} width="600" height="800"
              alt={`${m.name} — equipo de Virtus Estudio Jurídico en Salcedo`} loading="lazy" decoding="async" />
            <div class="team-info">
              <h3>{m.name}</h3>
              <div class="rule rule-gold rule-small"></div>
              <p>{m.focus}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="clientes" class="clientes">
    <div class="wrap clientes-grid">
      <div>
        <span class="kicker">CLIENTES EMPRESARIALES</span>
        <div class="rule"></div>
        <p class="clientes-desc">Acompañamiento legal continuo a negocios de Salcedo y Latacunga en materia contractual, laboral, de cobranzas y de marcas.</p>
        <img src="/fotos/reunion-abogados-virtus-con-cliente.webp" width="896" height="597" alt="Abogados de Virtus Estudio Jurídico en reunión con un cliente empresarial en Salcedo" class="clientes-img" loading="lazy" decoding="async" />
      </div>
      <div class="clientes-list">
        {clients.map((c) => (
          <div class="cliente-row">
            <span class="cliente-name">{c.name}</span>
            <span class="cliente-city">{c.city}</span>
          </div>
        ))}
        <a href={WA_EMPRESA} target="_blank" rel="noopener" class="cliente-cta">
          <span>¿Su empresa?</span>
          <span class="cliente-cta-label">Solicitar propuesta</span>
        </a>
      </div>
    </div>
  </section>


  <section id="calculadora" class="herramienta">
    <div class="wrap">
      <span class="kicker kicker-gold">HERRAMIENTA GRATUITA</span>
      <div class="rule rule-gold"></div>
      <h2 class="h-light">Calculadora de pensiones alimenticias 2026</h2>
      <p class="lead">
        Calcule en un minuto el valor referencial de la pensión según la Tabla 2026 (SBU $482):
        ingreso mensual, aporte al IESS, número de hijos, rango de edad y grado de discapacidad.
        El cálculo se descarga en PDF.
      </p>
      <div class="btn-row">
        <a href="/calculadora-pension-alimenticia" class="btn btn-gold">Abrir la calculadora</a>
        <a href="/pension-alimenticia-como-se-fija" class="btn btn-outline">Cómo se fija la pensión</a>
      </div>
    </div>
  </section>

  <section id="cobertura" class="cobertura">
    <div class="wrap">
      <div class="servicios-head">
        <div>
          <span class="kicker">COBERTURA</span>
          <h2>Abogados en Cotopaxi y la sierra centro</h2>
        </div>
        <p class="servicios-desc">Oficina en Salcedo, patrocinio en Latacunga, Ambato y a nivel nacional. Cada materia con su propio equipo responsable.</p>
      </div>
      <div class="cobertura-grid">
        {ciudades.map((c) => (
          <a class="cobertura-card" href={`/${c.slug}`}>
            <span class="cobertura-kicker">{c.kicker}</span>
            <span class="cobertura-title">{c.h1}</span>
            <span class="cobertura-desc">{c.intro.split(". ")[0]}.</span>
          </a>
        ))}
      </div>
      <div class="materias-grid">
        {materias.map((m) => (
          <a class="materia-link" href={`/${m.slug}`}>
            <span>{m.materia}</span>
            <span class="materia-arrow">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="preguntas" class="faq-section">
    <div class="wrap">
      <span class="kicker">PREGUNTAS FRECUENTES</span>
      <h2 class="faq-h2">Lo que más nos consultan</h2>
      <div class="faq-list">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="contacto" class="contacto">
    <div class="wrap contacto-grid">
      <div>
        <h2 class="h-light">Conversemos sobre su caso.</h2>
        <p class="contacto-lead">Primera reunión de valoración para entender el asunto, los plazos y la estrategia adecuada.</p>
        <div class="btn-row">
          <a href={WA_GENERAL} target="_blank" rel="noopener" class="btn btn-gold">Escribir por WhatsApp</a>
          <a href={`tel:${PHONE}`} class="btn btn-outline">Llamar ahora</a>
        </div>
      </div>
      <div class="contacto-info">
        <div>
          <div class="info-label">WhatsApp y teléfono</div>
          <p><a class="info-link" href={`tel:${PHONE}`}>{PHONE_HUMAN}</a></p>
        </div>
        <div>
          <div class="info-label">Disponibilidad</div>
          <p>Urgencias 24/7<br />Consultas ordinarias en horario de oficina</p>
        </div>
        <div>
          <div class="info-label">Oficina</div>
          <p>Salcedo, Edificio Vecamores<br />frente a la Judicatura de Salcedo</p>
        </div>
        <div>
          <div class="info-label">Dirección</div>
          <p>Bolívar y C. Belisario Quevedo</p>
        </div>
        <div>
          <div class="info-label">Cobertura</div>
          <p>Casos a nivel nacional, Ecuador</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
    const grid = document.getElementById("services-grid");
    const toggle = document.getElementById("services-toggle");
    const total = grid?.querySelectorAll(".service-item").length ?? 0;
    toggle?.addEventListener("click", () => {
      const expanded = grid?.getAttribute("data-expanded") === "true";
      grid?.setAttribute("data-expanded", String(!expanded));
      toggle.textContent = expanded ? `Ver las ${total} áreas` : "Ver menos";
    });
</script>
